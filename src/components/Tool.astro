---
import LenField from './LenField.astro';
// preset: starting values for a pre-set page (inches). note: the line shown until the visitor types.
interface Props { preset?: Record<string, unknown> | null; note?: string; }
const { preset = null, note = 'Sample wall. Type yours.' } = Astro.props;
---
<section id="tool" aria-label="Board and batten calculator" data-preset={preset ? JSON.stringify(preset) : undefined} data-note={note} class="rounded-2xl border border-line bg-card p-4 shadow-[var(--card-shadow)] sm:p-6">
  <p class="print-title hidden text-lg font-bold">Board and batten layout</p>
  <p id="print-summary" class="print-summary hidden"></p>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]">
    <form id="form" class="no-print grid content-start gap-5" autocomplete="off" onsubmit="return false">
      <div role="status" aria-atomic="true">
        <p id="msg" class="hidden rounded-xl border border-[#b3261e] bg-[color-mix(in_oklab,#b3261e_8%,var(--card))] p-3 font-medium"></p>
      </div>
      <div class="flex items-center justify-between gap-3">
        <span class="lbl mb-0" id="units-l">Units</span>
        <div class="seg" role="radiogroup" aria-labelledby="units-l">
          <label><input class="sr-only" type="radio" name="units" value="in" checked /><span>Feet and inches</span></label>
          <label><input class="sr-only" type="radio" name="units" value="cm" /><span>Metric</span></label>
        </div>
      </div>

      <fieldset class="m-0 min-w-0 border-0 p-0" data-len="width">
        <legend class="lbl">Wall width</legend>
        <LenField id="width" label="Wall width" ft="12" inch="0" />
      </fieldset>
      <fieldset class="m-0 min-w-0 border-0 p-0" data-len="height">
        <legend class="lbl">Wall height</legend>
        <LenField id="height" label="Wall height" ft="8" inch="0" />
      </fieldset>

      <fieldset class="m-0 min-w-0 border-0 p-0" data-len="batten">
        <legend class="lbl">Batten width</legend>
        <div class="mb-2 flex flex-wrap gap-2" role="group" aria-label="Common batten sizes">
          <button type="button" class="chip" data-in="1.5" aria-pressed="false">1x2</button>
          <button type="button" class="chip" data-in="2.5" aria-pressed="true">1x3</button>
          <button type="button" class="chip" data-in="3.5" aria-pressed="false">1x4</button>
        </div>
        <LenField id="batten" label="Batten width" inch="2" fr={8} />
        <p class="imp mt-1 text-xs text-muted">A 1x3 board is 2 1/2 in wide, a 1x4 is 3 1/2 in.</p>
        <p class="met mt-1 hidden text-xs text-muted">A 1x3 board is about 6.4 cm wide, a 1x4 about 8.9 cm.</p>
      </fieldset>

      <fieldset class="m-0 min-w-0 border-0 p-0">
        <legend class="lbl">I know</legend>
        <div class="seg" role="radiogroup" aria-label="What you know">
          <label><input class="sr-only" type="radio" name="mode" value="count" checked /><span>How many battens</span></label>
          <label><input class="sr-only" type="radio" name="mode" value="gap" /><span>The gap I want</span></label>
        </div>
        <div id="mode-count" class="mt-3 flex items-center gap-2">
          <button type="button" class="step" id="count-down" aria-label="One fewer batten">&minus;</button>
          <div class="grow"><label class="sr-only" for="count">Number of battens</label><input class="fld text-center text-lg font-bold" id="count" inputmode="numeric" value="10" /></div>
          <button type="button" class="step" id="count-up" aria-label="One more batten">+</button>
        </div>
        <div id="mode-gap" class="mt-3 hidden" data-len="gap">
          <LenField id="gap" label="Gap" inch="12" />
          <p class="mt-1 text-xs text-muted">The tool picks the batten count that comes closest to this gap, then makes every gap equal.</p>
        </div>
      </fieldset>

      <div>
        <label class="chk"><input type="checkbox" id="ends" checked /> Batten at each end of the wall</label>
        <label class="chk"><input type="checkbox" id="rails-on" /> Add horizontal rails</label>
        <label class="chk"><input type="checkbox" id="wide-on" /> Different width for the end battens</label>
        <label class="chk"><input type="checkbox" id="anchor-on" /> Center on a window, TV or mirror</label>
      </div>

      <fieldset id="wide-box" class="m-0 hidden min-w-0 rounded-xl border border-line p-3" data-len="endb">
        <legend class="lbl px-1">End batten width</legend>
        <LenField id="endb" label="End batten width" inch="3" fr={8} />
        <p class="mt-2 text-xs text-muted">Applies to the first and last batten when you have a batten at each end. The gaps stay equal.</p>
      </fieldset>

      <fieldset id="anchor-box" class="m-0 hidden min-w-0 rounded-xl border border-line p-3" data-len="anchor">
        <legend class="lbl px-1">Middle of the feature, from the left edge</legend>
        <LenField id="anchor" label="Feature position from the left edge" ft="5" inch="4" />
        <div class="seg mt-3" role="radiogroup" aria-label="What sits on the middle of the feature">
          <label><input class="sr-only" type="radio" name="akind" value="gap" checked /><span>A gap</span></label>
          <label><input class="sr-only" type="radio" name="akind" value="batten" /><span>A batten</span></label>
        </div>
        <p class="mt-2 text-xs text-muted">The tool keeps the gap from above and slides the whole run until a gap (or a batten) is centered on this point. The count can change, and the two end spaces will not match. The end batten options do not apply.</p>
      </fieldset>

      <fieldset id="rails" class="m-0 hidden min-w-0 gap-3 rounded-xl border border-line p-3" data-len="rail">
        <legend class="lbl px-1">Rails</legend>
        <div class="grid gap-3">
          <div><label class="lbl" for="rail-count">Number of rails</label><input class="fld" id="rail-count" inputmode="numeric" value="2" /></div>
          <div>
            <span class="lbl" id="rail-w-l">Rail width</span>
            <div role="group" aria-labelledby="rail-w-l"><LenField id="rail" label="Rail width" inch="3" fr={8} /></div>
          </div>
        </div>
        <p class="mt-2 text-xs text-muted">Rails run the full width. The first rail sits on the floor and the last one at the ceiling, with equal gaps between. One rail sits in the middle.</p>
      </fieldset>
    </form>

    <div id="results" class="min-w-0 min-h-[34rem]">
      <div id="out">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          <div class="col-span-2 rounded-xl bg-brand-soft p-4 sm:col-span-1">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">Gap between battens</p>
            <p id="r-gap" class="font-mono text-2xl font-bold tabular-nums text-brand-ink sm:text-3xl">&nbsp;</p>
            <p id="r-gap-dec" class="text-sm text-muted tabular-nums">&nbsp;</p>
          </div>
          <div class="rounded-xl bg-brand-soft p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">Battens</p>
            <p id="r-count" class="font-mono text-2xl sm:text-3xl font-bold tabular-nums text-brand-ink">&nbsp;</p>
            <p class="text-sm text-muted" id="r-count-sub">&nbsp;</p>
          </div>
          <div class="rounded-xl bg-brand-soft p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">Center to center</p>
            <p id="r-pitch" class="font-mono text-2xl sm:text-3xl font-bold tabular-nums text-brand-ink">&nbsp;</p>
            <p class="text-sm text-muted">between marks</p>
          </div>
        </div>
        <p id="r-sample" class="mt-3 hidden rounded-lg border border-line bg-paper px-3 py-2 text-sm font-semibold"></p>
        <p id="r-note" class="mt-3 hidden text-sm font-medium"></p>
        <ul id="r-warn" class="mt-3 list-disc pl-5 text-sm text-muted"></ul>

        <figure class="mt-5 m-0">
          <div id="draw" class="overflow-hidden rounded-xl border border-line bg-paper"></div>
          <figcaption class="mt-1 text-xs text-muted">Drawn to scale. Numbers match the mark list below.</figcaption>
        </figure>

        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <div>
            <h2 class="mb-1 text-base font-bold">Marks from the left</h2>
            <p class="mb-2 text-sm text-muted">Measure from the left edge of the wall. Make a pencil mark at each center, then set each batten on its mark.</p>
            <div class="marks-wrap max-h-96 overflow-auto rounded-xl border border-line" tabindex="0" role="region" aria-label="Marks from the left, scrollable">
              <table class="tbl" id="marks"><thead><tr><th scope="col">#</th><th scope="col">Center</th><th scope="col">Left edge</th></tr></thead><tbody></tbody></table>
            </div>
          </div>
          <div>
            <div id="rails-out" class="hidden mb-6">
              <h2 class="mb-1 text-base font-bold">Rail marks from the floor</h2>
              <p class="mb-2 text-sm text-muted">Measure up from the floor to the center of each rail.</p>
              <div class="overflow-auto rounded-xl border border-line"><table class="tbl" id="rail-marks"><thead><tr><th scope="col">#</th><th scope="col">Center</th><th scope="col">Bottom edge</th></tr></thead><tbody></tbody></table></div>
            </div>
            <h2 class="mb-1 text-base font-bold">Cut list</h2>
            <ul id="cutlist" class="mb-4 list-disc pl-5"></ul>
            <h2 class="mb-1 text-base font-bold">Boards to buy</h2>
            <p class="mb-2 text-sm text-muted" id="buy-note"></p>
            <div class="overflow-auto rounded-xl border border-line"><table class="tbl" id="buy"><thead><tr><th scope="col">Board length</th><th scope="col">Boards</th><th scope="col">Waste</th></tr></thead><tbody></tbody></table></div>
          </div>
        </div>

        <div class="no-print mt-6 flex flex-wrap gap-3">
          <button type="button" class="btn btn-primary" id="copy">Copy cut list and marks</button>
          <button type="button" class="btn" id="copy-link">Copy link</button>
          <button type="button" class="btn" id="dl-png">Download drawing (PNG)</button>
          <button type="button" class="btn" id="dl-csv">Download marks (CSV)</button>
          <button type="button" class="btn" id="print">Print</button>
          <span id="copy-note" class="self-center text-sm text-muted" role="status"></span>
        </div>
        <p class="no-print mt-5 max-w-prose text-sm text-muted">Center to center is the distance from the middle of one batten to the middle of the next. This tool counts battens and rails only. It does not count the wide boards or panels behind them. With no end battens, the gap at each end of the wall equals every other gap. Short offcuts from 10 and 12 foot boards work well for small trim pieces.</p>
      </div>
    </div>
  </div>
</section>

<div id="sticky" class="no-print fixed inset-x-0 bottom-0 z-10 hidden border-t border-line bg-card/95 px-4 py-2 backdrop-blur lg:hidden">
  <a href="#results" class="mx-auto flex max-w-5xl items-center justify-between gap-3 text-ink no-underline">
    <span class="font-mono text-lg font-bold tabular-nums"><span id="s-count"></span> battens, <span id="s-gap"></span> gaps</span>
    <span class="text-sm font-semibold text-brand-ink">See marks</span>
  </a>
</div>

<script>
  import {
    parseInches, parseFeet, parseNumber, formatInches, formatFeetInches, formatCm, plan, MM_PER_IN,
  } from '../lib/layout.mjs';

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const el = (id: string) => document.getElementById(id) as HTMLElement;
  const form = el('form') as HTMLFormElement;
  const state = { metric: false };
  const checkedValue = (name: string) => (form.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement).value;

  // ---- read and write length fields ----
  const val = (id: string) => $(id)?.value ?? '';
  // Returns inches. NaN when the text makes no sense.
  function readLen(id: string): number {
    if (state.metric) {
      const cm = parseNumber(val(`${id}-cm`));
      return cm * 10 / MM_PER_IN;
    }
    const ft = document.getElementById(`${id}-ft`) ? parseFeet(val(`${id}-ft`)) : 0;
    const inTxt = val(`${id}-in`).trim();
    const inch = inTxt === '' ? 0 : parseInches(inTxt);
    const fr = parseInt(val(`${id}-fr`) || '0', 10) / 16;
    return ft + inch + fr;
  }
  function writeLen(id: string, inches: number) {
    if (!Number.isFinite(inches)) return;
    if (state.metric) { $(`${id}-cm`).value = String(Math.round(inches * MM_PER_IN) / 10); return; }
    const sixteenths = Math.round(inches * 16);
    const whole = Math.floor(sixteenths / 16);
    const fr = sixteenths % 16;
    if (document.getElementById(`${id}-ft`)) {
      $(`${id}-ft`).value = String(Math.floor(whole / 12));
      $(`${id}-in`).value = String(whole % 12);
    } else $(`${id}-in`).value = String(whole);
    $(`${id}-fr`).value = String(fr);
  }
  // Whole number from a box. NaN when there is any other text.
  function readCount(id: string): number {
    const t = val(id).trim();
    return /^\d+$/.test(t) ? Number(t) : NaN;
  }
  const groupIds = [...document.querySelectorAll<HTMLElement>('[data-len]')].map((e) => e.dataset.len!);

  function setUnits(metric: boolean) {
    if (metric === state.metric) return;
    const saved: Record<string, number> = {};
    for (const g of groupIds) saved[g] = readLen(g);
    state.metric = metric;
    document.querySelectorAll('.imp').forEach((e) => e.classList.toggle('hidden', metric));
    document.querySelectorAll('.met').forEach((e) => e.classList.toggle('hidden', !metric));
    for (const g of groupIds) writeLen(g, saved[g]);
  }

  // ---- text helpers ----
  const f1 = (n: number) => (Math.round(n * 100) / 100).toString();
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  // Feet and inches, or centimeters.
  const fmtLong = (x: number) => (state.metric ? formatCm(x) : formatFeetInches(x));
  // Inches only, or centimeters. Used for gaps and board widths.
  const fmtShort = (x: number) => (state.metric ? formatCm(x) : formatInches(x));
  // Words instead of the foot and inch marks, which are hard to read in a drawing: 11' 10 3/4" -> 11 ft 10 3/4 in
  const words = (t: string) => t.replace(/' ?/g, ' ft ').replace(/"/g, ' in').replace(/\s+/g, ' ').trim();
  const row = (cells: string[], cls = '') => `<tr class="${cls}">${cells.map((c, i) => (i === 0 ? `<th scope="row" class="px-2 py-1.5 text-left text-[0.95rem] font-semibold normal-case tracking-normal text-ink">${c}</th>` : `<td>${c}</td>`)).join('')}</tr>`;
  function stockLabel(inches: number) {
    return state.metric ? `${(Math.round(inches * MM_PER_IN / 100) / 10).toFixed(1)} m` : `${Math.round(inches / 12)} ft`;
  }

  // ---- drawing ----
  const NS = 'http://www.w3.org/2000/svg';
  let lastSvg = '';
  function draw(p: any, W: number, H: number, anchorX: number | null) {
    const fs = Math.max(W, H) / 20; // base text size; large enough to read on a phone
    const padL = fs * 2.2, padT = fs * 2, padR = fs * 0.8, padB = fs * 5.4;
    const vbW = W + padL + padR, vbH = H + padT + padB;
    const gapTxt = words(fmtShort(p.gap));
    const totalTxt = words(fmtLong(W));
    const heightTxt = words(fmtLong(H));
    const tick = fs * 0.35;
    let s = `<svg xmlns="${NS}" viewBox="0 0 ${f1(vbW)} ${f1(vbH)}" width="100%" role="img" aria-label="Wall drawing to scale: ${p.count} battens with ${esc(gapTxt)} gaps" style="display:block;max-height:34rem" font-family="ui-sans-serif,system-ui,sans-serif">`;
    s += `<g transform="translate(${f1(padL)} ${f1(padT)})">`;
    s += `<rect x="0" y="0" width="${f1(W)}" height="${f1(H)}" fill="var(--card)" stroke="var(--ink)" stroke-width="${f1(fs * 0.08)}"/>`;
    if (p.rails) {
      for (const r of p.rails.marks) {
        const y = H - r.right; // r.left is the bottom edge from the floor, r.right the top edge
        s += `<rect x="0" y="${f1(y)}" width="${f1(W)}" height="${f1(p.rails.width)}" fill="var(--brand-ink)" opacity="0.4"/>`;
      }
    }
    for (const m of p.marks) {
      s += `<rect x="${f1(m.left)}" y="0" width="${f1(m.right - m.left)}" height="${f1(H)}" fill="var(--brand-ink)"/>`;
    }
    if (anchorX !== null) {
      s += `<line x1="${f1(anchorX)}" y1="${f1(-fs * 0.2)}" x2="${f1(anchorX)}" y2="${f1(H)}" stroke="#b3261e" stroke-width="${f1(fs * 0.12)}" stroke-dasharray="${f1(fs * 0.4)} ${f1(fs * 0.3)}"/>`;
    }
    // number labels above: every k-th mark; the last one only when it does not touch the previous label
    const k = Math.max(1, Math.ceil((fs * 1.7) / p.pitch));
    for (const m of p.marks) {
      const regular = (m.n - 1) % k === 0;
      const lastFits = m.n === p.count && ((m.n - 1) % k) * p.pitch >= fs * 1.7;
      if (regular || lastFits) {
        s += `<text x="${f1(m.center)}" y="${f1(-fs * 0.55)}" font-size="${f1(fs * 0.85)}" text-anchor="middle" fill="var(--muted)">${m.n}</text>`;
      }
    }
    // first gap dimension
    const first = p.marks[0];
    // With no end battens the first gap is the wall edge to the first batten. In an anchored layout the end space is not a gap, so use the first real gap.
    const edgeGap = first.left > 0 && anchorX === null;
    const gx1 = edgeGap ? 0 : first.right;
    const gx2 = edgeGap ? first.left : (p.marks[1] ? p.marks[1].left : W);
    const dy = H + fs * 1.4;
    s += `<g stroke="var(--ink)" stroke-width="${f1(fs * 0.07)}" fill="none"><path d="M${f1(gx1)} ${f1(dy - tick)}V${f1(dy + tick)}M${f1(gx2)} ${f1(dy - tick)}V${f1(dy + tick)}M${f1(gx1)} ${f1(dy)}H${f1(gx2)}"/></g>`;
    s += `<text x="${f1(gx2 + fs * 0.3)}" y="${f1(dy + fs * 0.32)}" font-size="${f1(fs * 0.85)}" fill="var(--ink)" font-weight="700">${esc(gapTxt)} gap</text>`;
    // total width dimension
    const dy2 = H + fs * 3.4;
    s += `<g stroke="var(--muted)" stroke-width="${f1(fs * 0.07)}" fill="none"><path d="M0 ${f1(dy2 - fs * 0.4)}V${f1(dy2 + fs * 0.4)}M${f1(W)} ${f1(dy2 - fs * 0.4)}V${f1(dy2 + fs * 0.4)}M0 ${f1(dy2)}H${f1(W)}"/></g>`;
    s += `<rect x="${f1(W / 2 - fs * 3.8)}" y="${f1(dy2 - fs * 0.6)}" width="${f1(fs * 7.6)}" height="${f1(fs * 1.2)}" fill="var(--paper)"/>`;
    s += `<text x="${f1(W / 2)}" y="${f1(dy2 + fs * 0.3)}" font-size="${f1(fs * 0.85)}" text-anchor="middle" fill="var(--muted)">${esc(totalTxt)}</text>`;
    // height dimension (left)
    const dx = -fs * 1.1;
    s += `<g stroke="var(--muted)" stroke-width="${f1(fs * 0.07)}" fill="none"><path d="M${f1(dx - tick)} 0H${f1(dx + tick)}M${f1(dx - tick)} ${f1(H)}H${f1(dx + tick)}M${f1(dx)} 0V${f1(H)}"/></g>`;
    s += `<text transform="translate(${f1(dx - fs * 0.25)} ${f1(H / 2)}) rotate(-90)" font-size="${f1(fs * 0.85)}" text-anchor="middle" fill="var(--muted)" paint-order="stroke" stroke="var(--paper)" stroke-width="${f1(fs * 0.5)}">${esc(heightTxt)}</text>`;
    s += `</g></svg>`;
    lastSvg = s;
    el('draw').innerHTML = s;
  }

  // ---- results ----
  let untouched = true;     // true until the visitor changes something: the sample line shows
  let last: any = null;     // last good plan, null while the inputs have an error
  let lastIn: any = null;   // the inputs that made it
  // Phone: show the summary bar only while the tool is on screen and the inputs are valid.
  let toolVisible = false;
  const updateSticky = () => el('sticky').classList.toggle('hidden', !(toolVisible && last));

  function showError(text: string, field = '') {
    const msg = el('msg');
    msg.textContent = text;
    msg.classList.toggle('hidden', !text);
    el('out').classList.toggle('hidden', !!text);
    form.querySelectorAll('[aria-invalid]').forEach((e) => { e.removeAttribute('aria-invalid'); e.removeAttribute('aria-describedby'); });
    if (text && field) {
      const ids = [`${field}-${state.metric ? 'cm' : 'ft'}`, `${field}-${state.metric ? 'cm' : 'in'}`, field];
      const target = ids.map((i) => document.getElementById(i)).find((e) => e);
      target?.setAttribute('aria-invalid', 'true');
      target?.setAttribute('aria-describedby', 'msg');
    }
  }

  // One list of lines for the on-page cut list and the copied text.
  function cutLines(p: any, input: any): string[] {
    const L = [`${p.count} vertical ${p.count === 1 ? 'batten' : 'battens'} at ${fmtLong(input.height)}`];
    if (p.rails) L.push(`${p.rails.count} horizontal ${p.rails.count === 1 ? 'rail' : 'rails'} at ${fmtLong(input.width)}`);
    const linear = state.metric ? `${Math.round(p.linear * 0.0254 * 10) / 10} m` : `${Math.round(p.linear / 12 * 10) / 10} linear ft`;
    L.push(`Total: ${linear}`);
    return L;
  }
  function summaryLine(p: any, input: any): string {
    const ends = input.withEnds ? 'batten at each end' : 'gap at each end';
    return `Wall ${fmtLong(input.width)} wide x ${fmtLong(input.height)} high. Battens ${fmtShort(input.batten)} wide, ${p.count} of them, ${ends}.${p.rails ? ` ${p.rails.count} ${p.rails.count === 1 ? 'rail' : 'rails'} ${fmtShort(p.rails.width)} wide.` : ''}`;
  }

  // Sample line, gap rounding echo and anchor end spaces.
  function showNotes(p: any, input: any) {
    const sample = el('r-sample');
    sample.textContent = el('tool').dataset.note || '';
    sample.classList.toggle('hidden', !untouched || !sample.textContent);
    let note = '';
    if (p.anchor) {
      note = `Centered on ${fmtLong(input.anchor.x)} from the left: ${p.anchor.kind === 'gap' ? 'a gap' : 'a batten'} sits there. The left end space is ${fmtShort(p.anchor.left)} and the right end space is ${fmtShort(p.anchor.right)}.`;
    } else if (input.mode === 'gap' && Math.abs(p.gap - input.targetGap) > 1 / 32) {
      note = `You asked for a ${fmtShort(input.targetGap)} gap. The nearest even layout has ${p.count} battens, with gaps of ${fmtShort(p.gap)} (${p.gap > input.targetGap ? 'wider' : 'narrower'} by ${fmtShort(Math.abs(p.gap - input.targetGap))}).`;
    }
    const n = el('r-note');
    n.textContent = note;
    n.classList.toggle('hidden', !note);
  }

  function compute() {
    const input = {
      width: readLen('width'),
      height: readLen('height'),
      batten: readLen('batten'),
      mode: checkedValue('mode') as 'count' | 'gap',
      count: readCount('count'),
      targetGap: readLen('gap'),
      withEnds: $('ends').checked,
      metric: state.metric,
      rails: { on: $('rails-on').checked, count: readCount('rail-count'), width: readLen('rail') },
      endWidth: $('wide-on').checked ? readLen('endb') : 0,
      anchor: { on: $('anchor-on').checked, x: readLen('anchor'), kind: checkedValue('akind') },
    };
    const p = !input.endWidth && $('wide-on').checked && $('ends').checked
      ? { ok: false, errors: ['Enter the end batten width.'], field: 'endb' }
      : plan(input);
    document.querySelectorAll<HTMLElement>('.chip').forEach((c) =>
      c.setAttribute('aria-pressed', String(Math.abs(parseFloat(c.dataset.in!) - input.batten) < 1e-6)));
    if (!p.ok) {
      last = lastIn = null;
      showError(p.errors[0], p.field);
      updateSticky();
      return;
    }
    showError('');
    last = p; lastIn = input;

    el('r-gap').textContent = fmtShort(p.gap);
    el('r-gap-dec').textContent = state.metric ? `${Math.round(p.gap * MM_PER_IN * 10) / 10} mm` : `${Math.round(p.gap * 1000) / 1000} in exact`;
    el('r-count').textContent = String(p.count);
    el('r-count-sub').textContent = `${p.gapCount} equal gaps`;
    el('r-pitch').textContent = fmtShort(p.pitch);
    el('r-warn').innerHTML = p.warnings.map((w: string) => `<li>${esc(w)}</li>`).join('');
    el('s-count').textContent = String(p.count);
    el('s-gap').textContent = fmtShort(p.gap);
    el('print-summary').textContent = summaryLine(p, input);

    draw(p, input.width, input.height, p.anchor ? input.anchor.x : null);
    showNotes(p, input);

    const markRow = (m: any) => row([String(m.n), `<strong>${fmtLong(m.center)}</strong>`, fmtLong(m.left)]);
    el('marks').querySelector('tbody')!.innerHTML = p.marks.map(markRow).join('');
    el('rails-out').classList.toggle('hidden', !p.rails);
    if (p.rails) el('rail-marks').querySelector('tbody')!.innerHTML = p.rails.marks.map(markRow).join('');

    el('cutlist').innerHTML = cutLines(p, input).map((c) => `<li>${esc(c)}</li>`).join('');
    el('buy').querySelector('tbody')!.innerHTML = p.buy
      .map((b: any) => b.boards === null
        ? row([stockLabel(b.stock), 'Too short', '&ndash;'])
        : row([stockLabel(b.stock), String(b.boards), `${Math.round(b.waste * 100)}%`], b === p.best ? 'best' : ''))
      .join('');
    el('buy-note').textContent = p.best
      ? `Best fit: ${p.best.boards} boards of ${stockLabel(p.best.stock)}. Counts include ${state.metric ? 'a 3 mm' : 'a 1/8 in'} saw cut. Buy one extra for mistakes.`
      : 'No stock length is long enough for the battens. Pick shorter battens or splice them.';
    if (!untouched) writeHash();
    updateSticky();
  }

  // ---- copy ----
  function copyText(): string {
    if (!last || !lastIn) return '';
    const p = last;
    const L: string[] = ['Board and batten layout', summaryLine(p, lastIn),
      `Gap ${fmtShort(p.gap)}, center to center ${fmtShort(p.pitch)}.`, ...(p.anchor ? [`Left end space ${fmtShort(p.anchor.left)}, right end space ${fmtShort(p.anchor.right)}.`] : []), '', 'Marks (center, from the left):'];
    for (const m of p.marks) L.push(`${m.n}. ${fmtLong(m.center)}`);
    if (p.rails) {
      L.push('', 'Rail marks (center, from the floor):');
      for (const m of p.rails.marks) L.push(`${m.n}. ${fmtLong(m.center)}`);
    }
    L.push('', 'Cut list:', ...cutLines(p, lastIn), '', 'Boards to buy:');
    for (const b of p.buy) L.push(b.boards === null ? `${stockLabel(b.stock)}: too short` : `${stockLabel(b.stock)}: ${b.boards} boards`);
    return L.join('\n');
  }
  async function copyToClipboard(text: string, done: string) {
    const note = el('copy-note');
    try { await navigator.clipboard.writeText(text); note.textContent = done; }
    catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.cssText = 'position:fixed;left:-9999px;top:0';
      const prev = document.activeElement as HTMLElement | null;
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); note.textContent = done; } catch { note.textContent = 'Could not copy. Select the text and copy by hand.'; }
      ta.remove(); prev?.focus();
    }
    setTimeout(() => (note.textContent = ''), 2500);
  }
  $('copy').addEventListener('click', () => {
    const text = copyText();
    if (!text) { el('copy-note').textContent = 'Fix the inputs first.'; return; }
    copyToClipboard(text, 'Copied.');
  });
  $('copy-link').addEventListener('click', () => {
    if (!last) { el('copy-note').textContent = 'Fix the inputs first.'; return; }
    writeHash();
    copyToClipboard(location.href, 'Link copied.');
  });
  $('print').addEventListener('click', () => window.print());

  // ---- downloads ----
  function download(blob: Blob, name: string) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }
  const csvCell = (t: string) => `"${t.replace(/"/g, '""')}"`;
  $('dl-csv').addEventListener('click', () => {
    if (!last || !lastIn) { el('copy-note').textContent = 'Fix the inputs first.'; return; }
    const p = last;
    const rows: string[][] = [['Item', 'Number', 'Center', 'Edge', 'Note']];
    for (const m of p.marks) rows.push(['Batten', String(m.n), fmtLong(m.center), fmtLong(m.left), 'from the left edge of the wall']);
    if (p.rails) for (const m of p.rails.marks) rows.push(['Rail', String(m.n), fmtLong(m.center), fmtLong(m.left), 'from the floor']);
    for (const c of cutLines(p, lastIn)) rows.push(['Cut list', '', '', '', c]);
    for (const b of p.buy) rows.push(['Boards to buy', b.boards === null ? '' : String(b.boards), '', '', `${stockLabel(b.stock)}${b.boards === null ? ' (too short)' : ''}`]);
    download(new Blob([rows.map((r) => r.map(csvCell).join(',')).join('\r\n')], { type: 'text/csv' }), 'board-and-batten-marks.csv');
  });
  // The PNG always uses the light palette, so it prints well and reads the same in dark mode.
  const LIGHT: Record<string, string> = { '--card': '#ffffff', '--paper': '#ffffff', '--ink': '#16181b', '--muted': '#5b6068', '--brand-ink': '#415415' };
  $('dl-png').addEventListener('click', () => {
    if (!last || !lastSvg) { el('copy-note').textContent = 'Fix the inputs first.'; return; }
    const vb = lastSvg.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/)!;
    const vw = parseFloat(vb[1]), vh = parseFloat(vb[2]);
    const px = 1600, pxH = Math.round((px * vh) / vw);
    let svg = lastSvg.replace(/var\((--[\w-]+)\)/g, (_m, v) => LIGHT[v] || '#000')
      .replace('width="100%"', `width="${px}" height="${pxH}"`)
      .replace(/ style="[^"]*"/, '');
    svg = svg.replace('>', `><rect width="100%" height="100%" fill="#ffffff"/>`);
    const img = new Image();
    img.onload = () => {
      const c = document.createElement('canvas');
      c.width = px; c.height = pxH;
      const ctx = c.getContext('2d')!;
      ctx.drawImage(img, 0, 0, px, pxH);
      c.toBlob((b) => { if (b) download(b, 'board-and-batten-layout.png'); else el('copy-note').textContent = 'Could not make the image.'; }, 'image/png');
    };
    img.onerror = () => { el('copy-note').textContent = 'Could not make the image.'; };
    img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
  });

  // ---- share link in the address hash ----
  // Every text box and select with an id, except the hidden unit set.
  const fieldIds = [...form.querySelectorAll<HTMLInputElement>('input[id]:not([type=checkbox]):not([type=radio]), select[id]')].map((e) => e.id);
  const activeIds = () => fieldIds.filter((id) => (state.metric ? !/-(ft|in|fr)$/.test(id) : !/-cm$/.test(id)));
  function writeHash() {
    try {
      const q = new URLSearchParams();
      q.set('u', state.metric ? 'cm' : 'in');
      q.set('m', checkedValue('mode'));
      q.set('e', $('ends').checked ? '1' : '0');
      q.set('r', $('rails-on').checked ? '1' : '0');
      q.set('w', $('wide-on').checked ? '1' : '0');
      q.set('a', $('anchor-on').checked ? '1' : '0');
      q.set('k', checkedValue('akind'));
      for (const id of activeIds()) q.set(id, val(id));
      history.replaceState(null, '', '#' + q.toString());
    } catch {}
  }
  function readHash() {
    try {
      if (!location.hash) return;
      const q = new URLSearchParams(location.hash.slice(1));
      if (q.get('u') === 'cm') { (form.querySelector('input[name="units"][value="cm"]') as HTMLInputElement).checked = true; setUnits(true); }
      const m = q.get('m');
      if (m === 'gap' || m === 'count') (form.querySelector(`input[name="mode"][value="${m}"]`) as HTMLInputElement).checked = true;
      if (q.get('e') !== null) $('ends').checked = q.get('e') === '1';
      if (q.get('r') !== null) $('rails-on').checked = q.get('r') === '1';
      if (q.get('w') !== null) $('wide-on').checked = q.get('w') === '1';
      if (q.get('a') !== null) $('anchor-on').checked = q.get('a') === '1';
      const k = q.get('k');
      if (k === 'gap' || k === 'batten') (form.querySelector(`input[name="akind"][value="${k}"]`) as HTMLInputElement).checked = true;
      for (const id of fieldIds) { const v = q.get(id); if (v !== null) $(id).value = v.slice(0, 12); }
    } catch {}
  }

  // ---- wiring ----
  function syncVisibility() {
    el('mode-count').classList.toggle('hidden', checkedValue('mode') !== 'count');
    el('mode-gap').classList.toggle('hidden', checkedValue('mode') !== 'gap');
    el('rails').classList.toggle('hidden', !$('rails-on').checked);
    el('wide-box').classList.toggle('hidden', !$('wide-on').checked);
    el('anchor-box').classList.toggle('hidden', !$('anchor-on').checked);
  }
  // Text boxes update on every key. Selects, radios and checkboxes update on change.
  const isText = (t: HTMLInputElement) => t.tagName === 'INPUT' && t.type === 'text';
  form.addEventListener('input', (e) => {
    if (!isText(e.target as HTMLInputElement)) return;
    untouched = false;
    compute();
  });
  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (isText(t)) return;
    untouched = false;
    if (t.name === 'units') setUnits(t.value === 'cm');
    syncVisibility(); compute();
  });
  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) =>
    c.addEventListener('click', () => { untouched = false; writeLen('batten', parseFloat(c.dataset.in!)); compute(); }),
  );
  $('count-up').addEventListener('click', () => { untouched = false; $('count').value = String((readCount('count') || 0) + 1); compute(); });
  $('count-down').addEventListener('click', () => { untouched = false; $('count').value = String(Math.max(1, (readCount('count') || 2) - 1)); compute(); });

  new IntersectionObserver((entries) => { toolVisible = entries[0].isIntersecting; updateSticky(); }).observe(el('tool'));
  // A pre-set page starts from its own numbers (inches). A shared link in the address hash wins over them.
  function applyPreset() {
    try {
      const raw = el('tool').dataset.preset;
      if (!raw) return;
      const pr = JSON.parse(raw);
      for (const g of ['width', 'height', 'batten']) if (pr[g] > 0) writeLen(g, pr[g]);
      if (pr.mode === 'gap') {
        (form.querySelector('input[name="mode"][value="gap"]') as HTMLInputElement).checked = true;
        writeLen('gap', pr.targetGap);
      }
      if (pr.count) $('count').value = String(pr.count);
      if (pr.ends === false) $('ends').checked = false;
      if (pr.rails) { $('rails-on').checked = true; $('rail-count').value = String(pr.rails.count); writeLen('rail', pr.rails.width); }
      if (pr.endWidth) { $('wide-on').checked = true; writeLen('endb', pr.endWidth); }
    } catch {}
  }
  applyPreset();
  if (location.hash) untouched = false;
  readHash();
  syncVisibility();
  compute();
</script>

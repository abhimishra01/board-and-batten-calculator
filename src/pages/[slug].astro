---
// One pre-rendered page per entry in src/data/layouts.ts. Tables come from layout.mjs, so they match the tool.
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import AdSlot from '../components/AdSlot.astro';
import site from '../site.config.ts';
import { href } from '../lib/url.ts';
import { layouts } from '../data/layouts.ts';
import { plan, solveByGap, solveByCount, formatInches, formatFeetInches } from '../lib/layout.mjs';

export function getStaticPaths() {
  return layouts.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const base = `https://${site.domain}`;
const B3 = 2.5;
const fi = formatFeetInches;
const inch = formatInches;

type Table = { caption: string; intro?: string; head: string[]; rows: string[][]; rowHead?: boolean };
const tables: Table[] = [];
let preset: Record<string, unknown> = { width: 144, height: 96, batten: B3, count: 10 };

if (page.kind === 'wall') {
  const W = page.ft! * 12;
  const rec = solveByGap(W, B3, 12, true);
  preset = { width: W, height: 96, batten: B3, count: rec.count };
  const rows: string[][] = [];
  for (let n = 2; n <= 40; n++) {
    const r = solveByCount(W, B3, n, true);
    if (r.gap > 20 || r.gap < 6) continue;
    const p = plan({ width: W, height: 96, batten: B3, mode: 'count', count: n, withEnds: true });
    rows.push([String(n), inch(r.gap), inch(B3 + r.gap), fi(p.marks[0].center), fi(p.marks[1].center), `${p.best.boards} x ${p.best.stock / 12} ft`]);
  }
  tables.push({
    caption: `${page.ft} ft wall, 1x3 battens, batten at each end`,
    intro: `Gaps from 6 to 20 inches. Marks are the center of the first two battens, measured from the left edge. Boards are for an 8 ft ceiling.`,
    head: ['Battens', 'Gap', 'Center to center', '1st center', '2nd center', 'Boards to buy'],
    rows, rowHead: true,
  });
  const widths: [string, number][] = [['1x2', 1.5], ['1x3', 2.5], ['1x4', 3.5]];
  tables.push({
    caption: `The same ${page.ft} ft wall with other batten widths`,
    intro: 'Each row picks the count that comes closest to a 12 inch gap.',
    head: ['Batten', 'Width', 'Battens', 'Gap'],
    rows: widths.map(([n, w]) => { const r = solveByGap(W, w, 12, true); return [n, inch(w), String(r.count), inch(r.gap)]; }),
    rowHead: true,
  });
} else if (page.kind === 'batten') {
  const w = page.batten!;
  preset = { width: 144, height: 96, batten: w, count: solveByGap(144, w, 12, true).count };
  const walls = [8, 10, 12, 14, 16];
  tables.push({
    caption: `Battens and gaps for ${inch(w)} wide battens`,
    intro: 'A batten at each end. Each count gives the gap nearest 8, 12 or 16 inches.',
    head: ['Wall width', 'Battens', 'Gap', 'Battens', 'Gap', 'Battens', 'Gap'],
    rows: walls.map((ft) => {
      const cells = [8, 12, 16].map((g) => { const r = solveByGap(ft * 12, w, g, true); return [String(r.count), inch(r.gap)]; });
      return [`${ft} ft`, ...cells.flat()];
    }),
    rowHead: true,
  });
  tables.push({
    caption: 'Center to center distance',
    intro: `The distance from the middle of one batten to the middle of the next is the gap plus ${inch(w)}.`,
    head: ['Gap', 'Center to center'],
    rows: [6, 8, 10, 12, 14, 16].map((g) => [inch(g), inch(g + w)]),
    rowHead: true,
  });
} else if (page.kind === 'ends') {
  preset = { width: 144, height: 96, batten: B3, count: 10, ends: false };
  tables.push({
    caption: 'With and without end battens (1x3 battens, gap nearest 12 inches)',
    head: ['Wall width', 'End battens: count', 'Gap', 'No end battens: count', 'Gap'],
    rows: [8, 10, 12, 14].map((ft) => {
      const a = solveByGap(ft * 12, B3, 12, true);
      const b = solveByGap(ft * 12, B3, 12, false);
      return [`${ft} ft`, String(a.count), inch(a.gap), String(b.count), inch(b.gap)];
    }),
    rowHead: true,
  });
  const a = plan({ width: 144, height: 96, batten: B3, mode: 'count', count: 10, withEnds: true });
  const b = plan({ width: 144, height: 96, batten: B3, mode: 'count', count: 10, withEnds: false });
  tables.push({
    caption: 'Ten 1x3 battens on a 12 ft wall: the first marks',
    intro: 'Centers measured from the left edge. Same wall, same battens. Only the end option changes.',
    head: ['Batten', 'With end battens', 'No end battens'],
    rows: [0, 1, 2].map((i) => [String(i + 1), fi(a.marks[i].center), fi(b.marks[i].center)]).concat([['Gap', inch(a.gap), inch(b.gap)]]),
    rowHead: true,
  });
} else if (page.kind === 'boards') {
  preset = { width: 144, height: 96, batten: B3, count: solveByGap(144, B3, 12, true).count };
  tables.push({
    caption: 'Boards to buy by wall width (8 ft ceiling, 1x3 battens, gap nearest 12 inches)',
    intro: 'Battens only. Counts allow 1/8 inch per saw cut.',
    head: ['Wall width', 'Battens', '8 ft boards', '10 ft boards', '12 ft boards', 'Best'],
    rows: [8, 10, 12, 14, 16].map((ft) => {
      const c = solveByGap(ft * 12, B3, 12, true).count;
      const p = plan({ width: ft * 12, height: 96, batten: B3, mode: 'count', count: c, withEnds: true });
      const cell = (b: any) => (b.boards === null ? 'too short' : String(b.boards));
      return [`${ft} ft`, String(c), ...p.buy.map(cell), `${p.best.boards} x ${p.best.stock / 12} ft`];
    }),
    rowHead: true,
  });
  tables.push({
    caption: 'Ceiling height changes the best board (12 ft wall, 11 battens)',
    intro: 'A batten as long as the wall is high. Waste is the share of bought wood that is not used.',
    head: ['Ceiling', 'Batten length', 'Best board', 'Boards', 'Waste'],
    rows: [96, 108, 120].map((h) => {
      const p = plan({ width: 144, height: h, batten: B3, mode: 'count', count: 11, withEnds: true });
      return [`${h / 12} ft`, fi(h), `${p.best.stock / 12} ft`, String(p.best.boards), `${Math.round(p.best.waste * 100)}%`];
    }),
    rowHead: true,
  });
} else if (page.kind === 'gap') {
  preset = { width: 144, height: 96, batten: B3, mode: 'gap', targetGap: 12 };
  const look: Record<number, string> = { 8: 'Tight and formal', 10: 'Traditional', 12: 'Balanced', 14: 'Open', 16: 'Calm and modern' };
  tables.push({
    caption: 'Gap you ask for and what you get on a 12 ft wall (1x3 battens, end battens)',
    intro: 'The tool rounds to a whole number of battens, so the real gap is close to your target but not the same.',
    head: ['You ask for', 'Battens', 'Real gap', 'Center to center', 'Look'],
    rows: [8, 10, 12, 14, 16].map((g) => { const r = solveByGap(144, B3, g, true); return [inch(g), String(r.count), inch(r.gap), inch(B3 + r.gap), look[g]]; }),
    rowHead: true,
  });
  tables.push({
    caption: 'The same gaps on a 9 ft wall',
    head: ['You ask for', 'Battens', 'Real gap'],
    rows: [8, 10, 12, 14, 16].map((g) => { const r = solveByGap(108, B3, g, true); return [inch(g), String(r.count), inch(r.gap)]; }),
    rowHead: true,
  });
} else if (page.kind === 'rails') {
  preset = { width: 144, height: 96, batten: B3, count: 10, rails: { count: 2, width: 3.5 } };
  tables.push({
    caption: 'Rail marks on an 8 ft high wall (1x4 rails, 3 1/2 inches wide)',
    intro: 'Centers measured up from the floor. The first rail sits on the floor and the last one at the ceiling.',
    head: ['Rails', 'Gap between rails', 'Rail centers from the floor'],
    rows: [1, 2, 3, 4].map((n) => {
      const p = plan({ width: 144, height: 96, batten: B3, mode: 'count', count: 10, withEnds: true, rails: { on: true, count: n, width: 3.5 } });
      return [String(n), n === 1 ? 'one rail only' : inch(p.rails.gap), p.rails.marks.map((m: any) => fi(m.center)).join(', ')];
    }),
    rowHead: true,
  });
  tables.push({
    caption: 'Boards to buy with and without rails (12 ft wall, 10 battens, 8 ft high)',
    head: ['Plan', 'Linear feet', 'Best board', 'Boards'],
    rows: [0, 2].map((n) => {
      const p = plan({ width: 144, height: 96, batten: B3, mode: 'count', count: 10, withEnds: true, rails: n ? { on: true, count: n, width: 3.5 } : undefined });
      return [n ? `Battens + ${n} rails` : 'Battens only', String(Math.round(p.linear / 12)), `${p.best.stock / 12} ft`, String(p.best.boards)];
    }),
    rowHead: true,
  });
}

const others = layouts.filter((l) => l.slug !== page.slug);
const url = `${base}/${page.slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name, item: `${base}/` },
      { '@type': 'ListItem', position: 2, name: page.short, item: url },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base jsonLd={jsonLd} rawTitle={`${page.metaTitle} | ${site.name}`} description={page.description}>
  <section class="mx-auto max-w-5xl px-4 pt-10 sm:pt-16">
    <nav aria-label="Breadcrumb" class="mb-3 text-sm text-muted"><a href={href('/')} class="underline-offset-4 hover:underline">Board and batten calculator</a> <span aria-hidden="true">/</span> {page.short}</nav>
    <h1 class="max-w-3xl text-3xl font-extrabold leading-[1.1] tracking-tight [text-wrap:balance] sm:text-5xl">{page.h1}</h1>
    <div class="prose-site mt-4">{page.intro.map((t) => <p>{t}</p>)}</div>
    <div class="mt-8"><Tool preset={preset} note={page.note} /></div>
    <AdSlot />
  </section>
  <section class="mx-auto max-w-5xl px-4 pt-16">
    <article class="prose-site">
      {tables.map((t) => (
        <>
          <h2>{t.caption}</h2>
          {t.intro && <p>{t.intro}</p>}
          <div class="overflow-x-auto">
            <table class="tbl">
              <thead><tr>{t.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>{t.rows.map((r) => (
                <tr>{r.map((c, i) => (i === 0 && t.rowHead ? <th scope="row" class="px-2 text-left">{c}</th> : <td>{c}</td>))}</tr>
              ))}</tbody>
            </table>
          </div>
        </>
      ))}
      {page.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          {s.p.map((t) => <p>{t}</p>)}
        </>
      ))}
      <h2>Questions</h2>
      {page.faq.map((f) => (<><h3 style="font-weight:650;margin:1rem 0 .25rem">{f.q}</h3><p>{f.a}</p></>))}
      <h2>Other layouts</h2>
      <ul>
        {others.map((o) => <li><a href={href(`/${o.slug}/`)}>{o.h1}</a></li>)}
        <li><a href={href('/')}>The full board and batten calculator</a></li>
      </ul>
    </article>
  </section>
</Base>

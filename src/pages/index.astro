---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import Article from '../components/Article.astro';
import AdSlot from '../components/AdSlot.astro';
import Faq from '../components/Faq.astro';
import site from '../site.config.ts';
import { faq } from '../data/faq.ts';
import { layouts } from '../data/layouts.ts';
import { href } from '../lib/url.ts';

const base = site.origin;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: `${base}/`,
    description: site.description,
    applicationCategory: site.category,
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    inLanguage: site.locale,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Person', name: 'Abhishek Mishra', jobTitle: 'Software Development Engineer', worksFor: { '@type': 'Organization', name: 'Oqu AI' }, url: 'https://bingemind.com/abhishek-mishra/' },
    publisher: { '@type': 'Organization', name: 'Bingemind', url: 'https://bingemind.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base jsonLd={jsonLd} rawTitle="Board and Batten Calculator: Spacing and Cut List">
  <section class="mx-auto max-w-5xl px-4 pt-10 sm:pt-16">
    <p class="mb-3 inline-block rounded-full bg-brand-soft px-3 py-1 text-sm font-medium text-brand-ink">Board and batten spacing calculator</p>
    <h1 class="max-w-3xl text-4xl font-extrabold leading-[1.05] tracking-tight [text-wrap:balance] sm:text-6xl">
      Board and Batten Calculator
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">Find the exact spacing for board and batten on your wall. Get a mark for every batten, a drawing to scale and the boards to buy. Free, with no sign-up.</p>
    <div class="mt-8"><Tool /></div>
    <AdSlot />
  </section>
  <Article />
  <section aria-labelledby="layouts-h" class="mx-auto max-w-5xl px-4 pt-16">
    <h2 id="layouts-h" class="text-2xl font-bold tracking-tight">Layouts for common cases</h2>
    <p class="mt-2 max-w-2xl text-muted">Each page opens the calculator with the numbers for one case and adds a table for it.</p>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2">
      {layouts.map((l) => (
        <li><a href={href(`/${l.slug}/`)} class="block rounded-xl border border-line bg-card p-4 no-underline hover:border-brand"><span class="font-semibold text-ink">{l.h1}</span><span class="mt-1 block text-sm text-muted">{l.blurb}</span></a></li>
      ))}
    </ul>
  </section>
  <Faq />
</Base>
